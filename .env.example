# Copy to .env and fill in. Never commit .env.
# Production (Render) settings and where each value comes from: see DEPLOY.md.

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# GitHub App (Settings → Developer settings → GitHub Apps → your app)
GITHUB_APP_ID=
WEBHOOK_SECRET=
# The private key: a path to the .pem file, OR the key itself in GITHUB_PRIVATE_KEY
GITHUB_PRIVATE_KEY_PATH=./your-app.private-key.pem
# GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32 random bytes in base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Groq (console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Where the dashboard runs (used for the sign-in callback)
DASHBOARD_URL=http://localhost:3001
