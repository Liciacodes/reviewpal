# Where the ReviewPal API (the Express server) runs. Only the dashboard server uses this:
# it forwards /api, /auth and /health there, so the browser never calls the API directly.
API_ORIGIN=http://localhost:3000

# true: "Sign in with GitHub" is the main button on the sign-in page. Unset/false (default): "View demo" is,
# with a note that sign-in is limited to invited accounts (the GitHub App is private). Read at build time.
# PUBLIC_SIGNIN=true
