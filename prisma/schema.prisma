// ReviewPal data model.
// Connection URLs live in prisma.config.ts (CLI) and src/db.ts (app), not here (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReviewStatus {
  pending
  done
  failed
}

enum Severity {
  bug
  risk
  style
}

enum Feedback {
  useful
  not_useful
}

// A GitHub repository where the app is installed
model Repo {
  id             String   @id @default(cuid())
  owner          String
  name           String
  installationId Int
  createdAt      DateTime @default(now())
  reviews        Review[]

  @@unique([owner, name])
}

// One AI review of one commit (headSha) of a pull request
model Review {
  id           String          @id @default(cuid())
  repoId       String
  repo         Repo            @relation(fields: [repoId], references: [id], onDelete: Cascade)
  prNumber     Int
  prTitle      String
  prUrl        String
  headSha      String
  status       ReviewStatus    @default(pending)
  errorMessage String?         @db.Text
  model        String
  filesChanged Int             @default(0)
  notReviewed  Json?           // files the AI did not see: [{ filename, reason }] (lock file, too large...)
  createdAt    DateTime        @default(now())

  // Posting the review to the GitHub pull request
  githubReviewId String?   // GitHub's id for the review we posted (set = already posted). A string because the ids are bigger than Int.
  postedAt       DateTime?
  postError      String?   @db.Text // why posting failed (the review itself can still be "done")

  files        ReviewFile[]
  comments     ReviewComment[]

  // GitHub can redeliver a webhook: never review the same commit twice
  @@unique([repoId, prNumber, headSha])
  @@index([createdAt])
}

// A changed file in the PR, with its diff
model ReviewFile {
  id       String  @id @default(cuid())
  reviewId String
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  filename String
  status   String
  patch    String? @db.Text // binary or huge files have no patch

  @@index([reviewId])
}

// One comment from the AI, plus the human rating of it
model ReviewComment {
  id        String    @id @default(cuid())
  reviewId  String
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  path      String
  line      Int
  severity  Severity
  body      String    @db.Text
  feedback  Feedback?
  createdAt DateTime  @default(now())

  @@index([reviewId])
}

// Someone who signed in to the dashboard with GitHub
model User {
  id                 String    @id @default(cuid())
  githubId           String    @unique // a string, like githubReviewId: GitHub ids can outgrow Int
  login              String
  name               String?
  avatarUrl          String?
  accessToken        String    @db.Text // GitHub user token, AES-256-GCM encrypted (see src/auth/crypto.ts)
  accessTokenExpires DateTime?
  refreshToken       String?   @db.Text // encrypted too
  allowedRepos       Json? // cache of [{ installationId, fullName }] the user can see
  accessCheckedAt    DateTime? // when allowedRepos was last fetched from GitHub
  createdAt          DateTime  @default(now())
  sessions           Session[]
}

// A signed-in browser. The cookie holds a random token; we only store its SHA-256 hash.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfToken String // must come back in the X-CSRF-Token header on changes
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
